<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Business acceptance scenarios (Gherkin + Reqnroll on xUnit).
    @api features run against the real API hosted in memory with a throw-away SQL Server database
    (the same host as ApexPost.Api.IntegrationTests, linked below); the status-lifecycle feature runs
    against the domain rule directly.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>ApexPost.Specs</RootNamespace>
    <!-- Reqnroll writes the .feature.cs code-behind; keep generator-side warnings visible but non-fatal. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CS8669;CS0618</WarningsNotAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Reqnroll.xUnit" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/ApexPost.Api/ApexPost.Api.csproj" />
    <ProjectReference Include="../../src/ApexPost.Infrastructure/ApexPost.Infrastructure.csproj" />
    <ProjectReference Include="../../src/ApexPost.Domain/ApexPost.Domain.csproj" />
    <ProjectReference Include="../../src/ApexPost.Courier/ApexPost.Courier.csproj" />
    <ProjectReference Include="../../src/ApexPost.Courier.Offline/ApexPost.Courier.Offline.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- One definition of the in-memory API host, shared with ApexPost.Api.IntegrationTests. -->
    <Compile Include="../ApexPost.Api.IntegrationTests/Infrastructure/ApiTestHost.cs" Link="Support/ApiTestHost.cs" />
    <Compile Include="../ApexPost.Api.IntegrationTests/Infrastructure/TestAuthHandler.cs" Link="Support/TestAuthHandler.cs" />
  </ItemGroup>
</Project>
